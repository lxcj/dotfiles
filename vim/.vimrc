set nocompatible
syntax on
filetype plugin indent on

set clipboard=unnamedplus

set number
set relativenumber
set scrolloff=10

" Indentation
set expandtab
set tabstop=4
set shiftwidth=4
set autoindent
set smartindent

" Search
set ignorecase
set hlsearch

let mapleader = " "
nnoremap <esc> :nohlsearch<cr>
